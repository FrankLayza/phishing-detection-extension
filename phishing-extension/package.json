{
  "name": "phishing-detector",
  "displayName": "PhishGuard Extension",
  "version": "1.0.0",
  "description": "AI-based browser extension for advanced phishing detection",
  "author": "PhishGuard Team",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "postbuild": "node scripts/copy-assets.mjs",
    "copy:assets": "node scripts/copy-assets.mjs",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "plasmo": "0.89.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.251",
    "@types/node": "20.9.0",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "typescript": "5.2.2"
  },
  "manifest": {
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "activeTab",
      "tabs",
      "storage"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
